{
  "name": "tauri-download-center-core",
  "version": "1.0.0",
  "license": "Apache-2.0",
  "description": "Headless download-center client and state for Tauri plugins",
  "type": "module",
  "sideEffects": false,
  "files": ["dist", "types", "README.md"],
  "main": "./dist/index.js",
  "types": "./types/index.d.ts",
  "exports": { ".": { "types": "./types/index.d.ts", "import": "./dist/index.js" } },
  "scripts": { "build": "node -e \"require('fs').rmSync('types',{recursive:true,force:true})\" && vite build && tsc -p tsconfig.build.json" },
