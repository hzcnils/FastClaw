{
  "name": "tauri-download-center-vue",
  "version": "1.0.0",
  "license": "Apache-2.0",
  "description": "Reusable Vue UI and runtime for a Tauri download center",
  "type": "module",
  "sideEffects": ["**/*.css"],
  "files": ["dist", "types", "README.md"],
  "main": "./dist/index.js",
  "types": "./types/index.d.ts",
  "exports": {
    ".": { "types": "./types/index.d.ts", "import": "./dist/index.js" },
    "./style.css": "./dist/index.css"
  },
  "scripts": { "build": "node -e \"require('fs').rmSync('types',{recursive:true,force:true})\" && vite build && vue-tsc -p tsconfig.build.json", "typecheck": "vue-tsc -p tsconfig.json --noEmit" },
  "dependencies": { "tauri-download-center-core": "^1.0.0" },
  "peerDependencies": {
    "@tauri-apps/api": "^2.0.0",
    "element-plus": "^2.8.0",
    "lucide-vue-next": ">=0.460.0",
    "vue": "^3.5.0",
    "vue-i18n": "^9.0.0"
  },
  "peerDependenciesMeta": { "vue-i18n": { "optional": true } },
  "publishConfig": { "access": "public" }
}
