{
  "compilerOptions": {
    "baseUrl": ".",
    "types": ["vite/client"],
    "target": "ES2020",
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "paths": {
      "chat-renderer": ["../chat-renderer/dist/types/index.d.ts"],
      "planflow-runtime": ["../fastplan-runtime/dist/types/index.d.ts"],
      "planflow-planning-ui": ["../fastplan-planning-ui/types/index.d.ts"]
    },
    "esModuleInterop": true,
    "skipLibCheck": true,
    "strict": true
  },
  "include": ["src"],
  "exclude": ["src/**/*.test.ts"]
}
