{
  "name": "fastclaw",
  "private": true,
  "version": "1.0.0",
  "license": "Apache-2.0",
  "type": "module",
  "workspaces": [
    "download-packages/packages/*",
    "chat-plan-packages/*"
  ],
  "scripts": {
    "dev": "vite",
    "build": "npm run build:chat-plan-packages && npm run build:app",
    "build:app": "node --max-old-space-size=6144 ./node_modules/vite/bin/vite.js build",
    "preview": "vite preview",
    "tauri": "tauri",
    "tauri:dev": "tauri dev --release --features dev-db,devtools --no-watch",
    "tauri:dev:watch": "tauri dev --release --features dev-db,devtools",
    "test": "vitest run",
    "test:watch": "vitest",
    "build:packages": "npm run build -w tauri-download-center-core && npm run build -w tauri-download-center-vue",
    "build:chat-plan-packages": "npm run build -w chat-renderer && npm run build -w planflow-runtime && npm run build -w planflow-planning-ui && npm run build -w planflow-kit",
    "test:package-tarballs": "npm run build:packages && node scripts/test-package-tarballs.mjs"
  },
  "dependencies": {
    "@codemirror/autocomplete": "^6.20.2",
    "@codemirror/commands": "^6.10.3",
